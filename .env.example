# Copy to .env. Generate AUTH_SECRET with openssl rand -base64 32 or Node crypto.
DATABASE_URL=postgresql://nomeet:nomeet_local@localhost:5432/nomeet
REDIS_URL=redis://localhost:6379
JOB_QUEUE=nomeet
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
APP_URL=http://127.0.0.1:3000
ENABLE_LOCAL_AUTH=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMTP_URL=smtp://localhost:1025
MAIL_FROM=NoMeet <nomeet@example.test>
GEMINI_API_KEY=
GEMINI_MODEL=
# Estimate is recorded only when both per-million token prices are supplied.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
